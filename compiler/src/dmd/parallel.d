/**
 * Split the code generation of the root modules across forked worker processes.
 *
 * Once everything but code generation is done (semantic analysis and inlining, as for
 * an unsplit compilation), the original process plans which worker generates what
 * (see `dmd.glue.planSplit`) and forks the workers, which start from its state and
 * generate the code of the root modules and template instances the plan assigns them.
 * Each worker writes its output (an object file or a library) with a part suffix, and
 * the original process waits for the workers and combines the parts, in the order of
 * the workers, into the requested output.
 *
 * A function is generated by one worker. A function nested in another reaches the
 * frames enclosing it at the offsets the code generation of their functions assigns,
 * so a function is generated with the outermost function enclosing it, through
 * functions and aggregates: with it, it forms a group. A group whose outermost
 * function is of a root module and not a template instance function is generated by
 * the worker generating that module, and one of a template instance by the worker the
 * plan assigns the instance to. Code generation can instantiate templates, which the
 * plan does not know of: once their modules' code is generated, the workers settle in
 * rounds which of them generates each group of those. Every worker publishes the
 * functions it needs, and when all have, each group goes to one of the workers needing
 * it, chosen by its name. Generating those can need more, settled in the next round,
 * until no worker needs any. What each worker generates is so a function of the
 * sources and the flags only, not of how fast the workers run. A worker that finds it
 * cannot generate what an unsplit compilation would, such as a function another worker
 * needs that it has not generated, gives up the split.
 *
 * The processes of a split share memory (`NameTable` and `Rendezvous`) and files (the
 * output parts, and what each worker reports to the original process). Each piece of
 * it is read only once the writes it depends on are known to be done:
 *
 * $(UL
 * $(LI A name in the `NameTable` is written to arena space the worker reserves
 *      (`atomicFetchAdd` of `used`) before it publishes the entry by a `cas` of its
 *      slot, so a worker finding the entry through the slot reads the whole name.
 *      An entry reserved by a worker that lost the race for the slot stays in the
 *      arena with no worker needing it, which the scans of the arena skip.)
 * $(LI The fields `need`, `owner` and `group` of the entries and each worker's
 *      `pending` and `load` are written while the workers publish what they need,
 *      before they meet, and read after they meet: `meet` is a barrier, as each
 *      worker's arrival is a read-modify-write of `arrived` and the last to arrive
 *      releases the others by a store of `meetings` that they load. The scans of the
 *      arena between the meetings of a round see every entry published in the round.)
 * $(LI The `owner` of a group settled in a round is stored while the other workers
 *      may still be reading it in the same round; they only compare its round with
 *      the current one, which reads the same whether they see the store or not. The
 *      second meeting of the round separates those reads from the next publications.)
 * $(LI The `owner` of a group pinned to the worker compiling its module (see
 *      `noteLeftPinned`) is stored while the workers publish, so another worker
 *      publishing in the same round may or may not see it. No worker puts off a
 *      function of a pinned group, as every worker finds the same groups pinned, so
 *      what it reads there only concerns groups settled in earlier rounds, which the
 *      meetings order before it.)
 * $(LI `abort` is only ever set to give up, and `reason` is read by the original
 *      process once every worker has exited, after `waitpid`.)
 * $(LI A worker's output part, its output on stdout and stderr, and the results it
 *      reports are written before it exits, and read by the original process after
 *      `waitpid` has returned for every worker.)
 * )
 *
 * With the environment variable `DMD_SPLIT_STRESS` set to a number other than 0, every
 * process of a split sleeps for short pseudo-random times at each of these
 * synchronization points (see `stressPause`), changing with the number how the
 * workers interleave; the output must not change.
 *
 * Copyright:   Copyright (C) 1999-2026 by The D Language Foundation, All Rights Reserved
 * License:     $(LINK2 https://www.boost.org/LICENSE_1_0.txt, Boost License 1.0)
 */
module dmd.parallel;

import core.stdc.stdio;
import core.stdc.stdlib;
import core.stdc.string;

import dmd.arraytypes;
import dmd.dmodule;
import dmd.dtemplate : TemplateInstance;
import dmd.dsymbol : Dsymbol;
import dmd.globals;
import dmd.root.filename;

version (Posix)
{
    import core.sys.posix.sys.mman : mmap, MAP_ANON, MAP_FAILED, MAP_SHARED, PROT_READ, PROT_WRITE;
    import core.sys.posix.sys.types : pid_t;
    import core.sys.posix.sys.wait : waitpid, WIFEXITED, WEXITSTATUS;
    import core.sys.posix.unistd : dup2, fork, _exit, execvp, getpid;
}

/**************************************
 * Code generation can instantiate templates, adding the instances to the root
 * modules other workers generate; a worker adopts those it has added since the split
 * (or the last call), and those that were speculative at the split but that it has
 * since needed, to have their code generated (see `dmd.glue.instanceGeneratedHere`).
 * Returns:
 *      the instances adopted, semantically analyzed; none if this is not a worker
 */
TemplateInstance[] adoptLateInstances() @system
{
    import dmd.dsymbol : Dsymbol, PASS;
    import dmd.dsymbolsem : runDeferredSemantic3;
    import dmd.semantic3 : semantic3;

    TemplateInstance[] adopted;
    if (!adopting)
        return adopted;
    bool again = true;
    while (again)
    {
        again = false;
        size_t still = 0;
        foreach (ti; speculative)
        {
            if (!ti.minst)
                speculative[still++] = ti;
            else if (moduleWorker(ti.memberOf) != workerIndex)
            {
                if (ti.semanticRun < PASS.semantic3)
                    semantic3(ti, null);
                adopted ~= ti;
                again = true;
            }
        }
        speculative = speculative[0 .. still];
        foreach (k, m; lateOthers)
        {
            while (m.members && lateSeen[k] < m.members.length)
            {
                Dsymbol s = (*m.members)[lateSeen[k]++];
                if (auto ti = s.isTemplateInstance())
                {
                    semantic3(ti, null);
                    adopted ~= ti;
                    again = true;
                }
            }
        }
        runDeferredSemantic3();
    }
    return adopted;
}

/* In a worker: whether it adopts instances; the root modules other workers generate,
 * with how many of their members it has looked at; the template instances of the
 * root modules that were speculative at the split, until it adopts them
 */
private __gshared bool adopting;
private __gshared Module[] lateOthers;
private __gshared size_t[] lateSeen;
private __gshared TemplateInstance[] speculative;
private __gshared size_t[void*] membersAtSplit;     // of each of `lateOthers`

/// A root module another worker generates, with how many members it had at the split
struct OtherModule
{
    Module m;
    size_t membersAtSplit;
}

/// Returns: in a worker, the root modules other workers generate
OtherModule[] otherModules()
{
    OtherModule[] r;
    foreach (m; lateOthers)
        r ~= OtherModule(m, membersAtSplit[cast(void*)m]);
    return r;
}

nothrow:

/// The state of a compilation split across worker processes
struct Workers
{
    int index = -1;         /// in a worker, its number; -1 in the original process
    int count;              /// number of workers started, 0 if the compilation is not split
    bool succeeded;         /// in the original process: every worker wrote its output part
    uint[] assign;          /// the worker each root module is assigned to

    /// Returns: true if this is a forked worker
    bool isChild() const nothrow { return index >= 0; }
}

/// the process id of the original process of the split, which names the files it
/// and its workers write beside the output, so that no other compilation writing
/// the same output reads or replaces them
private __gshared int splitOwner;

/// Returns: the suffix added to the output file names of worker `index`
const(char)[] partSuffix(int index)
{
    char[32] buf = void;
    const n = snprintf(buf.ptr, buf.length, ".%d.part%d", splitOwner, index);
    return buf[0 .. n].idup;
}

/// Returns: the name of the temporary file the original process of the split writes
/// `file` to before renaming it to `file`
const(char)[] mergeTemporary(const(char)[] file)
{
    char[32] buf = void;
    const n = snprintf(buf.ptr, buf.length, ".%d.tmp", splitOwner);
    return file ~ buf[0 .. n];
}

/// The most workers a compilation is split across; each is a bit of a mask
enum maxWorkers = 32;

/* The number of workers a compilation is split across when the number is not given:
 * a constant rather than the number of processors, so that the output does not
 * depend on the machine
 */
private enum autoWorkers = 8;

version (Posix)
{
    /* Mangled names in memory shared by the workers: of the functions a worker
     * needs but does not generate, and of the groups of functions generated together
     * (see `Entry`), each with the workers needing it and, for a group, the worker
     * generating it
     */
    private struct NameTable
    {
        enum slotCount = 1 << 20;                   // a power of 2
        enum arenaSize = 64 << 20;
        shared(uint)[slotCount] slots;  // offset + 1 in `arena` of a name, 0 if free
        shared(uint) used;              // bytes of `arena` in use
        ubyte[arenaSize] arena;         // each name as an `Entry` followed by its characters
    }

    /* A name in a `NameTable`: of a function or a template instance, or of a group of
     * them that one worker generates, preceded by `groupMark` (see `generateSettled`).
     */
    private struct Entry
    {
        uint length;            // of the name
        /* of a function or template instance: the workers that need it; of a group:
         * the workers that need some of it and can generate it
         */
        shared(uint) need;
        /* of a group: the worker generating it + 1, and the round in which that was
         * settled shifted by `roundShift`; 0 until it is settled
         */
        shared(uint) owner;
        shared(uint) group;     // of a function or template instance: offset + 1 in the arena of its group
    }
    private enum roundShift = 8;
    private enum char groupMark = '\x01';

    /* Where the workers meet between the rounds of settling who generates the
     * template instance functions, in memory shared by the workers and the original
     * process
     */
    private struct Rendezvous
    {
        shared(uint) arrived;           // workers waiting for the others
        shared(uint) meetings;          // how many times all the workers have met
        shared(uint) abort;             // set when the split fails: waiting workers give up
        shared(uint)[maxWorkers] pending;   // how many functions or instances each worker has to settle
        shared(uint)[maxWorkers] load;      // the work each worker has done, in functions
        char[256] reason;               // why the first worker to give up did
    }

    private __gshared NameTable* names;         // in a worker
    private __gshared Rendezvous* rendezvous;
    private __gshared uint workerIndex;         // in a worker: its number
    private __gshared uint workerCount;         // in a worker: the number of workers

    /* In a worker: where it reports its results to the original process, and how
     * many library files were listed when it started
     */
    private __gshared FILE* resultFile;
    private __gshared size_t libfilesAtSplit;
}

/// A function or template instance whose generation waits for the workers to settle
/// who generates its group
private struct Pending
{
    Dsymbol s;
    const(char)[] name;     // its name in the table
    Dsymbol head;           // what is generated first of its group
    const(char)[] group;    // the name of its group
    bool canGenerateHead;   // this worker can generate `head`
}

/// A function or template instance this worker leaves to the worker compiling the
/// module its group is generated with
private struct LeftPinned
{
    const(char)[] name;
    const(char)[] group;
    uint owner;
}

private __gshared Pending[] pending;    // in a worker, in the order it needed them
private __gshared bool[const(char)[]] pendingNames;
private __gshared LeftPinned[] leftPinned;  // in a worker, until published
private __gshared bool[const(char)[]] groupsHere;     // the groups this worker generates
private __gshared bool[const(char)[]] generatedNames; // the functions and template instances it has generated
private __gshared bool settled;         // in a worker: no more rounds are held
private __gshared uint round;           // in a worker: the rounds held so far
private __gshared size_t needed;        // in a worker: the functions and template instances it has put off
private __gshared int[void*] moduleOwners;      // in a worker: the worker compiling each root module
private __gshared int[void*] instanceOwners;    // the worker generating each template instance of the plan

/**************************************
 * Returns: the number of workers to split the code generation of `modules` across,
 * from the number `requested`, 0 for as many as the amount of source warrants; less
 * than 2 if it is not to be split
 */
uint workerCountFor(ref Modules modules, uint requested)
{
    size_t n = requested;
    if (!n)
    {
        /* Starting a worker costs more than compiling a little source, so by
         * default there is one worker for each `sourcePerWorker` bytes of source
         */
        enum sourcePerWorker = 128 * 1024;
        size_t total;
        foreach (m; modules)
            total += m.src.length;
        n = autoWorkers;
        if (n > total / sourcePerWorker)
            n = total / sourcePerWorker;
    }
    if (n > maxWorkers)
        n = maxWorkers;
    if (n > modules.length)
        n = modules.length;
    return cast(uint)n;
}

/**************************************
 * Split the code generation of the root modules across worker processes.
 *
 * The original process forks the workers, which generate the code the plan of the split
 * (see `dmd.glue.planSplit`) assigns them, and waits for them. A worker's output goes to a temporary file: a worker
 * that prints anything (errors, warnings, deprecations, messages) or fails makes the
 * split unsuccessful, and the original process, still in its state from before the
 * split, then generates the code itself, so that diagnostics are exactly those of an
 * unsplit compilation. A worker also fails, and gives up the split, when it finds it
 * cannot generate what an unsplit compilation would; the original process then writes
 * the output an unsplit compilation writes.
 *
 * With the environment variable `DMD_SPLIT_LOG` set to a file name, the original
 * process appends to that file a line telling whether the split succeeded and, if a
 * worker gave it up, why.
 * Params:
 *      modules = the root modules; in a worker, narrowed to those it generates
 *      n = the number of workers, from `workerCountFor` and `dmd.glue.planSplit`;
 *          less than 2 not to split
 *      assign = the worker of each module, from `dmd.glue.planSplit`
 * Returns:
 *      the split
 */
Workers split(ref Modules modules, uint n, uint[] assign)
{
    Workers w;
    version (Posix)
    {
        import core.atomic : atomicLoad, atomicStore;
        import core.stdc.errno : errno, EINTR;

        if (n < 2)
        {
            clearPlan();
            return w;
        }

        void* r = mmap(null, Rendezvous.sizeof, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANON, -1, 0);
        void* t = mmap(null, NameTable.sizeof, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANON, -1, 0);
        if (r == MAP_FAILED || t == MAP_FAILED)
        {
            clearPlan();
            return w;
        }
        w.assign = assign;
        splitOwner = getpid();
        initStress();
        rendezvous = cast(Rendezvous*)r;
        names = cast(NameTable*)t;
        workerCount = cast(uint)n;
        foreach (j, m; modules)
            moduleOwners[cast(void*)m] = w.assign[j];

        fflush(stdout);
        fflush(stderr);
        libfilesAtSplit = global.params.libfiles.length;
        pid_t[] children;
        FILE*[] outputs;
        FILE*[] results;
        foreach (k; 0 .. n)
        {
            FILE* output = tmpfile();
            FILE* result = tmpfile();
            if (!output || !result)
                break;
            const pid = fork();
            if (pid == -1)
                break;
            if (pid == 0)
            {
                dup2(fileno(output), 1);
                dup2(fileno(output), 2);
                resultFile = result;
                workerIndex = cast(uint)k;
                w.index = cast(int)k;
                stressProcess = workerIndex + 1;
                stressCalls[] = 0;
                atexit(&leaving);
                break;
            }
            children ~= pid;
            outputs ~= output;
            results ~= result;
            stressPause(StressPoint.fork);
        }

        if (w.isChild)
        {
            w.count = cast(int)n;
            size_t k = 0;
            foreach (j, m; modules)
            {
                if (w.assign[j] == w.index)
                    modules[k++] = m;
                else if (m.members)
                {
                    lateOthers ~= m;
                    lateSeen ~= m.members.length;
                    membersAtSplit[cast(void*)m] = m.members.length;
                }
                if (m.members)
                    foreach (s; *m.members)
                        if (auto ti = s.isTemplateInstance())
                            if (!ti.minst)
                                speculative ~= ti;
            }
            modules.setDim(k);
            adopting = true;
            stressPause(StressPoint.start);
            return w;
        }

        names = null;               // the original process generates all it compiles
        moduleOwners = null;
        clearPlan();
        w.count = cast(int)children.length;
        w.succeeded = children.length == n;
        if (!w.succeeded)           // the workers started would wait for the others
            atomicStore(rendezvous.abort, 1u);
        auto exited = new bool[children.length];
        foreach (_; 0 .. children.length)
        {
            stressPause(StressPoint.wait);
            int status;
            pid_t pid;
            do
                pid = waitpid(-1, &status, 0);
            while (pid == -1 && errno == EINTR);
            if (pid == -1)
            {
                w.succeeded = false;
                break;
            }
            foreach (k, c; children)
            {
                if (c != pid)
                    continue;
                exited[k] = true;
                if (!WIFEXITED(status) || WEXITSTATUS(status) != 0)
                {
                    // a worker that failed fails the split: the others need not finish
                    w.succeeded = false;
                    atomicStore(rendezvous.abort, 1u);
                }
            }
        }
        foreach (k, output; outputs)
        {
            if (!exited[k] || fseek(output, 0, SEEK_END) != 0 || ftell(output) != 0)
                w.succeeded = false;
            fclose(output);
        }
        if (w.succeeded)
        {
            stressPause(StressPoint.readResults);
            foreach (result; results)
                readResult(result);
        }
        foreach (result; results)
            fclose(result);

        if (const log = getenv("DMD_SPLIT_LOG"))
        {
            if (FILE* f = fopen(log, "a"))
            {
                const reason = rendezvous.reason.ptr;
                fprintf(f, "split into %d workers: %s%s\n", w.count,
                    w.succeeded ? "succeeded".ptr : "failed".ptr,
                    w.succeeded || !*reason ? "".ptr : (": " ~ fromStringz(reason) ~ "\0").ptr);
                fclose(f);
            }
        }
    }
    return w;
}

private const(char)[] fromStringz(const(char)* s)
{
    return s[0 .. strlen(s)];
}

/// Returns: true if this is a worker of a split compilation, after the split
bool inSplitWorker()
{
    version (Posix)
        return names !is null;
    else
        return false;
}

/// Returns: the number of this worker, in a worker of a split compilation
uint thisWorker()
{
    version (Posix)
        return workerIndex;
    else
        return 0;
}

/// Returns: the number of workers, in a worker of a split compilation; 1 otherwise
uint workerStride()
{
    version (Posix)
        return names ? workerCount : 1;
    else
        return 1;
}

/// The synchronization points of a split at which `stressPause` sleeps
enum StressPoint : uint
{
    fork,           /// in the original process, after forking a worker
    start,          /// in a worker, once it has started
    publish,        /// in a worker, between publishing names in the shared table
    reserve,        /// in a worker, between reserving arena space for a name and publishing it
    arrive,         /// in a worker, before arriving at a meeting
    leave,          /// in a worker, after leaving a meeting
    settle,         /// in a worker, between settling the owners of groups
    generate,       /// in a worker, after generating a function or template instance
    giveUp,         /// in a worker giving up, before recording why
    writePart,      /// in a worker, before writing its output part
    report,         /// in a worker, before reporting its results
    exit,           /// in a worker, before exiting
    wait,           /// in the original process, before waiting for a worker
    readResults,    /// in the original process, before reading the workers' results
    merge,          /// in the original process, before combining the parts
}

/* The seed of the pauses of `stressPause`, from `DMD_SPLIT_STRESS`: 0 when off. Set by
 * `split` before it forks, so the workers inherit it.
 */
private __gshared ulong stressSeed;
private __gshared uint stressProcess;      // 0 in the original process, a worker's number + 1
private __gshared uint[StressPoint.max + 1] stressCalls;   // in this process, of each point

/**************************************
 * In a process of a split compilation with `DMD_SPLIT_STRESS` set, sleep for a
 * pseudo-random short time, a function of the seed, the process (the worker's number,
 * or the original process), the point and how many times this process has reached it.
 * Most pauses are short or none; some take milliseconds, so that a worker can fall
 * well behind the others.
 */
void stressPause(StressPoint point)
{
    version (Posix)
    {
        import core.sys.posix.time : nanosleep, timespec;

        if (!stressSeed)
            return;
        ulong x = stressSeed ^ (stressProcess + 1) * 0x9E3779B97F4A7C15UL ^
                  (point + 1) * 0xC2B2AE3D27D4EB4FUL ^ ulong(stressCalls[point]++) << 40;
        // splitmix64
        x += 0x9E3779B97F4A7C15UL;
        x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9UL;
        x = (x ^ (x >> 27)) * 0x94D049BB133111EBUL;
        x ^= x >> 31;
        // the points reached for every name pause rarely, the others often
        const frequent = point == StressPoint.publish || point == StressPoint.reserve ||
                         point == StressPoint.settle || point == StressPoint.generate;
        const roll = cast(uint)(x & 1023);
        x >>= 10;
        ulong micros;
        if (frequent ? roll < 8 : roll < 512)
            micros = x % 300;                       // up to 0.3 ms
        else if (frequent ? roll < 9 : roll < 768)
            micros = 1000 + x % 9000;               // 1 to 10 ms
        else if (!frequent && roll < 800)
            micros = 20_000 + x % 30_000;           // 20 to 50 ms
        else
            return;
        timespec ts = timespec(0, cast(int)(micros * 1000));
        nanosleep(&ts, null);
    }
}

private void initStress()
{
    stressSeed = 0;
    stressProcess = 0;
    stressCalls[] = 0;
    if (const s = getenv("DMD_SPLIT_STRESS"))
        stressSeed = strtoull(s, null, 0);
}

/**************************************
 * Returns: the worker of the split compilation compiling root module `m`, or -1 if
 * `m` is not one of its root modules or this is not a worker
 */
int moduleWorker(const Module m)
{
    if (auto p = cast(void*)m in moduleOwners)
        return *p;
    return -1;
}

/**************************************
 * Record that template instance `ti`, with the functions it encloses, is generated by
 * worker `k`, when planning the split.
 */
void setInstanceWorker(const TemplateInstance ti, uint k)
{
    instanceOwners[cast(void*)ti] = k;
}

/**************************************
 * Returns: the worker that the plan of the split has generate template instance
 * `ti`, or -1 if it has none, as the instance did not need its code generated when
 * the split happened
 */
int instanceWorker(const TemplateInstance ti)
{
    if (auto p = cast(void*)ti in instanceOwners)
        return *p;
    return -1;
}

private void clearPlan()
{
    instanceOwners = null;
}

/**************************************
 * In a worker, end it and with it the split, as it cannot generate what an unsplit
 * compilation would; the original process then compiles all the modules itself.
 * Params:
 *      reason = why, for `DMD_SPLIT_LOG`
 *      name = the symbol concerned
 */
void abandonSplit(const(char)[] reason, const(char)[] name)
{
    version (Posix)
    {
        if (names)
            giveUp(reason, name);
    }
}

/**************************************
 * In a worker, record that it has generated the function or template instance `name`.
 */
void noteGenerated(const(char)[] name)
{
    version (Posix)
    {
        if (names)
        {
            generatedNames[name] = true;
            stressPause(StressPoint.generate);
        }
    }
}

/**************************************
 * Decide whether this worker generates a function or template instance whose group
 * any worker needing it could generate. A group is what one worker generates as a
 * whole: a template instance with the functions it encloses, or a function with those
 * it encloses. A worker puts off what it needs until the workers settle who generates
 * the groups (see `settleRound`).
 * Params:
 *      s = the function or template instance
 *      name = its name, unique among them
 *      head = what is generated first of its group, its template instance or
 *             outermost function
 *      group = the name of the group
 *      canGenerateHead = this worker can generate `head`
 * Returns:
 *      true if this process is to generate `s` now: the compilation is not split, or
 *      the workers settled that this worker generates its group
 */
bool generateSettled(Dsymbol s, const(char)[] name, Dsymbol head, const(char)[] group, bool canGenerateHead)
{
    version (Posix)
    {
        if (!names)
            return true;
        if (group in groupsHere)
            return true;
        if (settled)
            giveUp("needed once the workers have settled who generates what", name);
        if (!(name in pendingNames))
        {
            pendingNames[name] = true;
            pending ~= Pending(s, name, head, group, canGenerateHead);
            ++needed;
        }
        return false;
    }
    else
        return true;
}

/**************************************
 * In a worker, record that it leaves the function or template instance `name` of
 * `group` to `owner`, the worker compiling the module the group is generated with.
 */
void noteLeftPinned(const(char)[] name, const(char)[] group, uint owner)
{
    version (Posix)
    {
        if (!names)
            return;
        if (settled)
            giveUp("left to another worker once the workers have settled who generates what", name);
        leftPinned ~= LeftPinned(name, group, owner);
    }
}

/**************************************
 * In a worker, take part in a round of settling which workers generate the groups of
 * what they have put off generating. Every worker, whether or not it has
 * any, takes part in each round, until a round in which none has any.
 *
 * Once every worker has published what it needs, each takes the same decisions: the
 * groups to settle are dealt out in the order of their names, each to the worker
 * needing it that has done the least work so far. When no worker has any left to
 * settle, each checks that it has generated everything another worker needs of the
 * groups it generates.
 * Params:
 *      generated = how many functions this worker has generated so far
 *      generate = set to what this worker is to generate in this round, the head of
 *                 each group first
 * Returns:
 *      false if no worker had any left to settle, and no more rounds are held
 */
bool settleRound(size_t generated, out Dsymbol[] generate)
{
    version (Posix)
    {
        import core.atomic : atomicLoad, atomicOp, atomicStore;

        if (!names || settled)
            return false;
        const uint bit = 1u << workerIndex;

        // tell the others what this worker needs that is not yet settled
        foreach (l; leftPinned)
        {
            stressPause(StressPoint.publish);
            auto g = find(groupKey(l.group), true);
            auto f = find(l.name, true);
            if (!g || !f)
                giveUp("out of space for names", l.name);
            atomicStore(g.owner, l.owner + 1);
            atomicStore(f.group, offsetOf(g) + 1);
            atomicOp!"|="(f.need, bit);
        }
        leftPinned = null;
        size_t kept = 0;
        foreach (p; pending)
        {
            stressPause(StressPoint.publish);
            auto g = find(groupKey(p.group), true);
            auto f = find(p.name, true);
            if (!g || !f)
                giveUp("out of space for names", p.name);
            atomicStore(f.group, offsetOf(g) + 1);
            atomicOp!"|="(f.need, bit);
            if (const owner = atomicLoad(g.owner))
            {
                if ((owner & ((1u << roundShift) - 1)) - 1 == workerIndex)
                    giveUp("put off although its group is generated here", p.name);
                continue;
            }
            if (p.canGenerateHead)
                atomicOp!"|="(g.need, bit);
            pending[kept++] = p;
        }
        pending = pending[0 .. kept];
        atomicStore(rendezvous.pending[workerIndex], cast(uint)kept);
        /* Analyzing the template instances a worker needs is much of its work, which
         * shows in how many of their functions it needs
         */
        atomicStore(rendezvous.load[workerIndex], cast(uint)(generated + needed / 3));
        meet();
        ++round;
        size_t total = 0;
        foreach (k; 0 .. workerCount)
            total += atomicLoad(rendezvous.pending[k]);
        if (!total)
        {
            settled = true;
            checkGenerated();
            return false;
        }

        /* The groups needed in this round: all those in the table not settled in an
         * earlier round, in the order of their names
         */
        static struct Need { ulong hash; const(char)[] name; Entry* e; }
        Need[] needs;
        const used = atomicLoad(names.used);
        for (size_t offset = 0; offset + Entry.sizeof <= used && offset < NameTable.arenaSize; )
        {
            auto e = cast(Entry*)(names.arena.ptr + offset);
            offset += entrySize(e.length);
            const name = (cast(const(char)*)(e + 1))[0 .. e.length];
            if (!name.length || name[0] != groupMark)
                continue;
            const owner = atomicLoad(e.owner);
            if (!atomicLoad(e.need) || owner && owner >> roundShift < round)
                continue;
            needs ~= Need(fnv(name), name, e);
        }
        __gshared Need[] sorting;
        extern (C) static int byName(const void* a, const void* b)
        {
            auto x = cast(const Need*)a, y = cast(const Need*)b;
            if (x.hash != y.hash)
                return x.hash < y.hash ? -1 : 1;
            const n = x.name.length < y.name.length ? x.name.length : y.name.length;
            if (const c = memcmp(x.name.ptr, y.name.ptr, n))
                return c;
            return (x.name.length > y.name.length) - (x.name.length < y.name.length);
        }
        qsort(needs.ptr, needs.length, Need.sizeof, &byName);

        size_t[maxWorkers] load;
        foreach (k; 0 .. workerCount)
            load[k] = atomicLoad(rendezvous.load[k]);
        foreach (ref n; needs)
        {
            const need = atomicLoad(n.e.need);
            uint owner = uint.max;
            foreach (k; 0 .. workerCount)
                if (need & (1u << k) && (owner == uint.max || load[k] < load[owner]))
                    owner = k;
            ++load[owner];
            if (owner == workerIndex)
            {
                stressPause(StressPoint.settle);
                atomicStore(n.e.owner, round << roundShift | (owner + 1));
                groupsHere[n.name[1 .. $]] = true;
            }
        }
        bool[const(char)[]] heads;
        foreach (p; pending)
        {
            if (p.group in groupsHere)
            {
                if (!(p.group in heads))
                {
                    heads[p.group] = true;
                    generate ~= p.head;
                }
                generate ~= p.s;
            }
            else if (!atomicLoad(find(groupKey(p.group), false).need))
                giveUp("no worker needing it can generate its group", p.name);
        }
        pending = null;
        pendingNames = null;
        // no worker publishes what it needs next before all have read the needs
        meet();
        return true;
    }
    else
        return false;
}

version (Posix)
{
    /* Once the rounds are over, check that this worker has generated everything another
     * worker needs of the groups it generates, and that everything needed is of a group
     * some worker generates
     */
    private void checkGenerated()
    {
        import core.atomic : atomicLoad;

        const used = atomicLoad(names.used);
        for (size_t offset = 0; offset + Entry.sizeof <= used && offset < NameTable.arenaSize; )
        {
            auto e = cast(Entry*)(names.arena.ptr + offset);
            offset += entrySize(e.length);
            const name = (cast(const(char)*)(e + 1))[0 .. e.length];
            if (!name.length || name[0] == groupMark || !atomicLoad(e.need))
                continue;
            const group = atomicLoad(e.group);
            if (!group)
                giveUp("needed by a worker with no group", name);
            auto g = cast(Entry*)(names.arena.ptr + group - 1);
            const owner = atomicLoad(g.owner) & ((1u << roundShift) - 1);
            if (!owner)
                giveUp("needed by a worker but of a group no worker generates", name);
            if (owner - 1 == workerIndex && !(name in generatedNames))
                giveUp("needed by a worker but not generated by the worker generating its group", name);
        }
    }

    /* Wait for all the workers to arrive. A worker that gives up waiting, as the
     * split has failed or the original process is gone, ends.
     */
    private void meet()
    {
        import core.atomic : atomicFetchAdd, atomicLoad, atomicStore;
        import core.sys.posix.time : nanosleep, timespec;
        import core.sys.posix.unistd : getppid;

        stressPause(StressPoint.arrive);
        const meeting = atomicLoad(rendezvous.meetings);
        if (atomicFetchAdd(rendezvous.arrived, 1) + 1 == workerCount)
        {
            atomicStore(rendezvous.arrived, 0u);
            atomicStore(rendezvous.meetings, meeting + 1);
            stressPause(StressPoint.leave);
            return;
        }
        for (uint spins = 0; atomicLoad(rendezvous.meetings) == meeting; ++spins)
        {
            if (atomicLoad(rendezvous.abort) || getppid() == 1)
                giveUp(null, null);
            timespec ts = timespec(0, spins < 100 ? 20_000 : 500_000);
            nanosleep(&ts, null);
        }
        stressPause(StressPoint.leave);
    }

    /* End this worker, and with it the split; the first worker to give up for a
     * `reason` records it, with the symbol `name` concerned
     */
    private void giveUp(const(char)[] reason, const(char)[] name)
    {
        import core.atomic : atomicStore, cas;
        if (reason.length && cas(&rendezvous.abort, 0u, 2u))
        {
            stressPause(StressPoint.giveUp);
            snprintf(rendezvous.reason.ptr, rendezvous.reason.length, "%.*s: %.*s",
                cast(int)reason.length, reason.ptr, cast(int)name.length, name.ptr);
        }
        atomicStore(rendezvous.abort, 1u);
        _exit(1);
    }

    /// When a worker ends before the rounds are over, the others are not to wait for it
    private extern (C) void leaving()
    {
        import core.atomic : atomicStore;
        if (!settled)
            atomicStore(rendezvous.abort, 1u);
    }

    private const(char)[] groupKey(const(char)[] group)
    {
        return groupMark ~ group;
    }

    private uint offsetOf(const Entry* e)
    {
        return cast(uint)(cast(const(ubyte)*)e - names.arena.ptr);
    }

    private size_t entrySize(size_t length)
    {
        return (Entry.sizeof + length + 3) & ~3;
    }

    private ulong fnv(const(char)[] name)
    {
        ulong h = 14695981039346656037UL;          // FNV-1a
        foreach (c; name)
        {
            h ^= c;
            h *= 1099511628211UL;
        }
        return h;
    }

    /* Find `name` in the shared table, adding it if it is not there and `add` is set.
     * Returns: the name's entry, null if the name is not there and not added, or the
     * table is out of space
     */
    private Entry* find(const(char)[] name, bool add)
    {
        import core.atomic : atomicFetchAdd, atomicLoad, cas;

        const h = fnv(name);
        uint mine;
        foreach (probe; 0 .. NameTable.slotCount)
        {
            shared(uint)* slot = &names.slots[(h + probe) & (NameTable.slotCount - 1)];
            uint v = atomicLoad(*slot);
            if (v == 0)
            {
                if (!add)
                    return null;
                if (!mine)
                {
                    const need = cast(uint)entrySize(name.length);
                    const offset = atomicFetchAdd(names.used, need);
                    if (offset + need > NameTable.arenaSize)
                        return null;
                    auto e = cast(Entry*)(names.arena.ptr + offset);
                    e.length = cast(uint)name.length;
                    memcpy(names.arena.ptr + offset + Entry.sizeof, name.ptr, name.length);
                    mine = offset + 1;
                    stressPause(StressPoint.reserve);
                }
                if (cas(slot, 0u, mine))
                    return cast(Entry*)(names.arena.ptr + mine - 1);
                v = atomicLoad(*slot);
            }
            auto e = cast(Entry*)(names.arena.ptr + v - 1);
            if (e.length == name.length && memcmp(e + 1, name.ptr, name.length) == 0)
                return e;
        }
        return null;
    }
}

/**************************************
 * End a worker once its output part is written, reporting to the original process
 * the library files it added to the link. A worker that has not settled with the
 * others what it generates takes part in the remaining rounds first.
 */
void exitWorker(bool ok)
{
    version (Posix)
    {
        if (names && !settled)
        {
            if (!ok)
                giveUp(null, null);
            Dsymbol[] generate;
            while (settleRound(0, generate))
                if (generate.length)
                    giveUp("to be generated once the worker's output is written", generate[0].ident.toString());
        }
        if (pending.length)
            ok = false;
        stressPause(StressPoint.report);
        foreach (name; global.params.libfiles[libfilesAtSplit .. $])
            fwrite(name, 1, strlen(name) + 1, resultFile);
        if (fflush(resultFile) != 0)
            ok = false;
        stressPause(StressPoint.exit);
    }
    // exit() rather than _exit(), so that an instrumented compiler writes its profile
    exit(ok ? 0 : 1);
}

/* Add the library files a worker reported to the link.
 */
version (Posix)
private void readResult(FILE* result)
{
    fseek(result, 0, SEEK_END);
    const size = ftell(result);
    if (size <= 0)
        return;
    auto buf = cast(char*)malloc(size);
    rewind(result);
    if (fread(buf, 1, size, result) != size)
        return;
    for (size_t i = 0; i < size; i += strlen(buf + i) + 1)
        global.params.libfiles.push(buf + i);
}

/// Returns: the names of the output parts written by `count` workers writing `file`;
/// a worker that took no modules writes none
const(char)[][] partNames(const(char)[] file, int count)
{
    const(char)[][] parts;
    foreach (k; 0 .. count)
    {
        const p = file ~ partSuffix(k);
        if (FileName.exists(p) == 1)
            parts ~= p;
    }
    return parts;
}

/// Delete output parts
void removeParts(const(char)[][] parts)
{
    foreach (p; parts)
        remove(toCString(p));
}

/**************************************
 * Combine object file parts into one object file with `ld -r`.
 * Params:
 *      objfile = the object file to write
 *      parts = the object files to combine
 * Returns:
 *      true on success
 */
bool mergeObjects(const(char)[] objfile, const(char)[][] parts)
{
    version (Posix)
    {
        stressPause(StressPoint.merge);
        const(char)*[] argv;
        argv ~= "ld";
        argv ~= "-r";
        const tmpfile = mergeTemporary(objfile);
        argv ~= "-o";
        argv ~= toCString(tmpfile);
        foreach (p; parts)
            argv ~= toCString(p);
        argv ~= null;

        fflush(stdout);
        fflush(stderr);
        const pid = fork();
        if (pid == -1)
            return false;
        if (pid == 0)
        {
            execvp(argv[0], argv.ptr);
            _exit(127);
        }
        int status;
        if (waitpid(pid, &status, 0) == -1 || !WIFEXITED(status) || WEXITSTATUS(status) != 0)
        {
            remove(toCString(tmpfile));
            return false;
        }
        return rename(toCString(tmpfile), toCString(objfile)) == 0;
    }
    else
        return false;
}

private const(char)* toCString(const(char)[] s)
{
    auto p = cast(char*)malloc(s.length + 1);
    memcpy(p, s.ptr, s.length);
    p[s.length] = 0;
    return p;
}

