// A function literal of a template instance function, which another worker
// generates, is generated by the worker whose code needs it: it is emitted where it
// is inlined, and it reaches no frame, so no other function needs to be generated
// with it. Here RedBlackTree.opEquals's literal, given to std.algorithm.equal.
module test.dshell.parallel_function_literal;

import dshell;
import std.algorithm : canFind;
import std.format : format;

int main()
{
    version (Posix) {} else return DISABLED;

    string files;
    foreach (m; ["a", "b", "c"])
    {
        std.file.write(format("%s/%s.d", Vars.OUTPUT_BASE, m), format(q{
            module %1$s;
            import std.container.rbtree, std.typecons;
            alias T = RedBlackTree!(Tuple!(long, "at", string, "key"), "a < b", false);
            bool use_%1$s(long x)
            {
                auto t1 = new T();
                auto t2 = new T();
                t1.insert(T.Elem(x, "k"));
                t2.insert(T.Elem(x, "k"));
                return t1 == t2;
            }
        }, m));
        files ~= format(" $OUTPUT_BASE/%s.d", m);
    }
    const log = Vars.OUTPUT_BASE ~ "/split.log";
    foreach (flags; ["-O -inline -release", ""])
    {
        if (std.file.exists(log))
            std.file.remove(log);
        run("$DMD -m$MODEL -j=3 -c " ~ flags ~ " -of=$OUTPUT_BASE/abc$OBJ" ~ files, stdout, stderr,
            ["DMD_SPLIT_LOG": log]);
        const result = std.file.readText(log);
        if (!result.canFind("succeeded"))
        {
            writefln("with '%s': %s", flags, result);
            return 1;
        }
    }
    return 0;
}
