// An object file with debug information is generated by one process unless the
// command line asks for workers: forking workers costs more than they save on the
// unoptimized code of a debug build, while an explicit `-j` still splits it.
module test.dshell.parallel_debug_default;

import dshell;
import std.algorithm : canFind;
import std.conv : to;

int main()
{
    version (Posix) {} else return DISABLED;

    // enough source that the default worker count splits a build without -g
    string files;
    foreach (m; 0 .. 4)
    {
        string src = "module m" ~ m.to!string ~ ";\n";
        foreach (f; 0 .. 1500)
            src ~= "int f" ~ f.to!string ~ "(int a) { int s = a; foreach (k; 0 .. a) s += k ^ " ~
                f.to!string ~ "; return s; }\n";
        std.file.write(Vars.OUTPUT_BASE ~ "/m" ~ m.to!string ~ ".d", src);
        files ~= " $OUTPUT_BASE/m" ~ m.to!string ~ ".d";
    }

    bool splits(string flags)
    {
        const log = Vars.OUTPUT_BASE ~ "/split.log";
        if (std.file.exists(log))
            std.file.remove(log);
        run("$DMD -m$MODEL " ~ flags ~ " -c -of=$OUTPUT_BASE/out$OBJ" ~ files, stdout, stderr,
            ["DMD_SPLIT_LOG": log]);
        return std.file.exists(log) && std.file.readText(log).canFind("split into");
    }

    if (!splits(""))
    {
        writeln("a build without -g is not split by default");
        return 1;
    }
    if (splits("-g"))
    {
        writeln("an object file with debug information is split without -j");
        return 1;
    }
    if (!splits("-g -j=4"))
    {
        writeln("an object file with debug information is not split with -j=4");
        return 1;
    }
    return 0;
}
